# Copy this file to .env and fill in the values before running docker compose.

MARIADB_ROOT_PASSWORD=changeme
MARIADB_DATABASE=nooto
MARIADB_USER=nooto
MARIADB_PASSWORD=changeme

# Port exposed on the host for the nooto-server (default: 3000)
SERVER_PORT=3000

# Memory budget shared by concurrent password hashes, in MiB (default: 256).
# One hash needs 19 MiB, so the default allows 13 concurrent hashes.
NOOTO_ARGON2_MEMORY_MIB=256

# Comma-separated IPs or CIDRs of reverse proxies allowed to set client IP
# headers. Leave empty to trust loopback and private ranges, or set to "none"
# to ignore forwarding headers entirely.
NOOTO_TRUSTED_PROXIES=
